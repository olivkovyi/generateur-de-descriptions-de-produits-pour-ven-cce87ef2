bles - La Signature de l'Élégance`;\n                    case 'soft':\n                        return `Découvrez ${name} : Une Douceur Unique pour Votre Quotidien`;\n                    case 'commercial':\n                        return `Offre Spéciale : ${name} - Le Cadeau Idéal pour Toutes les Occasions !`;\n                    default:\n                        return name;\n                }\n            };\n\n            const generateDescriptionParagraph = (style, name, keywords, features, audience, tone) => {\n                const combinedKeywords = keywords.length > 0 ? 'Mots-clés : ' + keywords.join(', ') + '.' : '';\n                const baseDescription = `Découvrez notre magnifique \"${name}\", une création unique pensée pour vous.`;\n                const featureList = features ? features.split('\\n').map(f => `- ${f.trim()}`).join('\\n') : '';\n                const audienceSentence = audience ? `Parfait pour ${audience}.` : '';\n\n                switch (style) {\n                    case 'seo':\n                        return `${baseDescription} Ce ${name} est le choix idéal pour quiconque recherche un ${keywords[0] || 'produit exceptionnel'}. Fait à la main avec passion, il intègre des caractéristiques comme : ${features || 'des matériaux de qualité supérieure et une conception soignée'}. ${audienceSentence} Pour un achat responsable et un style affirmé. ${combinedKeywords}`;\n                    case 'clickbait':\n                        return `💥 Attention, stock limité ! Notre \"${name}\" est la pièce dont tout le monde parle. Ses caractéristiques uniques (${features || 'qualité inégalée, design audacieux'}) en font un incontournable. Achetez maintenant avant qu'il ne soit trop tard et rejoignez le cercle des privilégiés !`;\n                    case 'expert':\n                        return `Conçu avec une maîtrise artisanale, le \"${name}\" incarne l'excellence. Chaque détail reflète un savoir-faire méticuleux, utilisant des matériaux de première qualité. Ses attributs incluent : ${features || 'une durabilité exceptionnelle et une esthétique raffinée'}. Un investissement dans l'art et l'élégance intemporelle.`;\n                    case 'soft':\n                        return `Laissez-vous charmer par la douceur et l'authenticité de notre \"${name}\". Un article pensé pour apporter confort et beauté à votre quotidien. Ses atouts : ${features || 'une conception délicate, des finitions parfaites'}. Une invitation à la sérénité et au bien-être. ${audienceSentence}`;\n                    case 'commercial':\n                        return `Optimisez votre achat avec le \"${name}\" ! Un excellent rapport qualité-prix pour cette pièce versatile. Bénéficiez de : ${features || 'une grande adaptabilité, une facilité d\\'utilisation'}. Idéal pour un cadeau ou pour vous faire plaisir. Profitez de nos offres exceptionnelles !`;\n                    default:\n                        return `${baseDescription} ${features ? `Ses caractéristiques incluent : ${features}.` : ''} ${audienceSentence}`;\n                }\n            };\n\n            const styles = [\n                { id: 'seo', name: 'SEO & Optimisé' },\n                { id: 'clickbait', name: 'Impactant & Viral' },\n                { id: 'expert', name: 'Qualité & Savoir-faire' },\n                { id: 'soft', name: 'Émotionnel & Doux' },\n                { id: 'commercial', name: 'Promotionnel & Vendeur' }\n            ];\n\n            styles.forEach(style => {\n                const groupDiv = document.createElement('div');\n                groupDiv.className = 'result-group';\n                resultDiv.appendChild(groupDiv);\n\n                const groupTitle = document.createElement('h4');\n                groupTitle.textContent = `Style : ${style.name}`;\n                groupDiv.appendChild(groupTitle);\n\n                const ul = document.createElement('ul');\n                groupDiv.appendChild(ul);\n\n                const headline = gener