    "document_html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Générateur de Descriptions de Produits pour Vendeurs en Ligne (Etsy/Indépendants) | Générez vos Descriptions Persuasives</title>\n    <meta name=\"description\" content=\"Créez des descriptions de produits attrayantes et optimisées pour le SEO, adaptées aux plateformes de vente en ligne comme Etsy ou les sites indépendants.\">\n    <style>\n        :root {\n            --color-primary: #1a1a1a;\n            --color-secondary: #f0f0f0;\n            --color-accent: #b80d6f;\n            --color-text: #333;\n            --color-light-text: #666;\n            --color-border: #ddd;\n            --font-family-sans: 'Helvetica Neue', Arial, sans-serif;\n            --font-family-mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;\n            --spacing-unit: 1rem;\n        }\n\n        body {\n            font-family: var(--font-family-sans);\n            color: var(--color-text);\n            margin: 0;\n            padding: 0;\n            background: linear-gradient(135deg, var(--color-secondary) 0%, #ffffff 100%);\n            line-height: 1.6;\n            display: flex;\n            flex-direction: column;\n            min-height: 100vh;\n        }\n\n        header {\n            background-color: var(--color-primary);\n            color: var(--color-secondary);\n            padding: calc(2 * var(--spacing-unit)) var(--spacing-unit);\n            text-align: center;\n            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n            position: relative;\n            z-index: 10;\n        }\n\n        header h1 {\n            margin: 0;\n            font-size: 2.5rem;\n            letter-spacing: -0.05em;\n            font-weight: 700;\n        }\n\n        header p {\n            font-size: 1.2rem;\n            margin-top: 0.5rem;\n            max-width: 800px;\n            margin-left: auto;\n            margin-right: auto;\n            opacity: 0.9;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: calc(3 * var(--spacing-unit)) auto;\n            padding: 0 calc(1.5 * var(--spacing-unit));\n            display: flex;\n            flex-wrap: wrap;\n            gap: calc(2 * var(--spacing-unit));\n            flex-grow: 1;\n        }\n\n        .tool-section, .info-section {\n            background-color: #fff;\n            padding: calc(2 * var(--spacing-unit));\n            border-radius: 8px;\n            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);\n            border: 1px solid var(--color-border);\n            display: flex;\n            flex-direction: column;\n        }\n\n        .tool-section {\n            flex: 2 1 600px;\n            min-width: 50%;\n            position: relative;\n        }\n\n        .info-section {\n            flex: 1 1 300px;\n            min-width: 30%;\n            background: var(--color-secondary);\n            border-color: #d0d0d0;\n        }\n\n        h2 {\n            color: var(--color-primary);\n            font-size: 1.8rem;\n            margin-top: 0;\n            margin-bottom: calc(1.5 * var(--spacing-unit));\n            border-bottom: 2px solid var(--color-accent);\n            padding-bottom: 0.5rem;\n        }\n\n        label {\n            display: block;\n            margin-bottom: 0.5rem;\n            font-weight: 600;\n            color: var(--color-light-text);\n            font-size: 0.95rem;\n        }\n\n        input[type=\"text\"],\n        textarea,\n        select {\n            width: 100%;\n            padding: 0.8rem;\n            margin-bottom: calc(1.5 * var(--spacing-unit));\n            border: 1px solid var(--color-border);\n            border-radius: 4px;\n            font-size: 1rem;\n            font-family: var(--font-family-sans);\n            box-sizing: border-box;\n            background-color: #f